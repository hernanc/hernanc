---
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { SITE } from '../consts';
import { href } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const {
  title,
  description = SITE.description,
  image,
  article = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.wordmark}` : `${SITE.title} — ${SITE.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? href('/og.svg'), Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<link rel="canonical" href={canonical} />

<link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.author} — Writing`}
  href={href('/rss.xml')}
/>
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0e0f11" media="(prefers-color-scheme: dark)" />

<!-- Open Graph / Twitter -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE.author} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Apply the saved theme before first paint to avoid a flash. -->
<script is:inline>
  (() => {
    try {
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia(
        '(prefers-color-scheme: dark)',
      ).matches;
      const dark = stored ? stored === 'dark' : prefersDark;
      document.documentElement.classList.toggle('dark', dark);
    } catch (_) {}
  })();
</script>
