---
import type { Post } from '../lib/posts';
import { href } from '../lib/url';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const url = href(`/blog/${post.id}`);
---

<article class="post-card">
  <a class="post-card-link" href={url} aria-label={post.data.title}></a>
  <FormattedDate date={post.data.pubDate} class="post-card-date" />
  <h3 class="post-card-title">{post.data.title}</h3>
  <p class="post-card-desc">{post.data.description}</p>
  {
    post.data.tags.length > 0 && (
      <ul class="post-card-tags">
        {post.data.tags.slice(0, 4).map((tag) => (
          <li class="tag">{tag}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .post-card {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-top: 1px solid var(--border);
  }

  /* Full-card click target, kept accessible via aria-label. */
  .post-card-link {
    position: absolute;
    inset: 0;
  }

  .post-card-date {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--text-faint);
  }

  .post-card-title {
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    transition: color 0.15s ease;
  }

  .post-card:hover .post-card-title {
    color: var(--accent);
  }

  .post-card-desc {
    color: var(--text-muted);
    max-width: var(--measure);
  }

  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin-top: var(--space-1);
  }

  /* Tags sit above the full-card link so they read as part of the card. */
  .post-card-tags .tag {
    position: relative;
  }
</style>
