---
interface Props {
  date: Date;
  class?: string;
}

const { date, class: className } = Astro.props;

const display = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const machine = date.toISOString().slice(0, 10);
---

<time datetime={machine} class={className}>{display}</time>
