---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SOCIALS } from '../consts';

const selectedWork = [
  {
    title: 'Lead DevOps Engineer, TextExpander',
    note: 'Leading DevOps for TextExpander since 2023, after four years as a DevOps Engineer on the same team. Multi-environment, auto-scalable AWS ECS infrastructure.',
  },
  {
    title: 'Senior Software Developer, Black Pixel',
    note: 'Five and a half years architecting and operating distributed, scalable, sharded backends for client products.',
  },
  {
    title: 'Lead Server Engineer, Glyder',
    note: 'Server lead for a mobile-first product in the San Francisco Bay Area, building distributed web services.',
  },
];
---

<BaseLayout
  title="About"
  description={`About ${SITE.author}, a backend and infrastructure engineer based in Argentina.`}
>
  <section class="about">
    <header class="about-head">
      <p class="eyebrow">About</p>
      <h1 class="about-name">{SITE.author}</h1>
    </header>

    <div class="about-body">
      <p class="lead">
        I'm a software engineer based in Argentina, with more than seventeen
        years designing and shipping software.
      </p>

      <p>
        Most of that career has been in backend development and the cloud
        infrastructure production systems depend on: distributed and scalable
        web services, multi-environment setups on AWS, and the day-to-day
        operational work that keeps a product healthy in production. I
        currently lead DevOps at TextExpander, after four years on the same
        team as a DevOps Engineer.
      </p>

      <p>
        Before TextExpander I spent five and a half years at Black Pixel as a
        Senior Software Developer, architecting and operating distributed
        backends for client products. Earlier still I led the server side at
        Glyder. The industries have ranged across social media, e-commerce,
        games, mobile, and the ETL and integration work between them, but the
        underlying problems have stayed broadly the same.
      </p>

      <p>
        What I care about is the practice of building software that holds up
        under real load and infrastructure you can keep changing without
        breaking it. This site is where I write about that kind of work.
      </p>

      <h2 class="about-section">Selected work</h2>
      <ul class="work-list">
        {
          selectedWork.map((item) => (
            <li class="work-item">
              <span class="work-title">{item.title}</span>
              <span class="work-note">{item.note}</span>
            </li>
          ))
        }
      </ul>

      <h2 class="about-section">Elsewhere</h2>
      <ul class="elsewhere">
        {
          SOCIALS.map((link) => (
            <li>
              <a
                href={link.href}
                rel={link.href.startsWith('mailto:') ? undefined : 'me noopener'}
                target={link.href.startsWith('mailto:') ? undefined : '_blank'}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: var(--space-8) var(--space-10);
  }

  .about-name {
    margin-top: var(--space-3);
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.022em;
  }

  .about-body {
    margin-top: var(--space-6);
  }

  .about-body > * + * {
    margin-top: var(--space-5);
  }

  .lead {
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--text);
  }

  .about-body p {
    color: var(--text-muted);
    line-height: 1.7;
  }

  .about-section {
    font-size: var(--text-lg);
    margin-top: var(--space-8);
  }

  .work-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .work-item {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-subtle);
  }

  .work-title {
    font-weight: 600;
  }

  .work-note {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .elsewhere {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  .elsewhere a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--accent-soft);
  }

  .elsewhere a:hover {
    text-decoration-color: var(--accent);
  }
</style>
