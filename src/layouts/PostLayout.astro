---
import { Image } from 'astro:assets';
import type { Post } from '../lib/posts';
import { readingTime } from '../lib/posts';
import { href } from '../lib/url';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { data } = post;
const minutes = readingTime(post.body);
---

<BaseLayout
  title={data.title}
  description={data.description}
  article={true}
  image={data.heroImage?.src}
>
  <article class="post">
    <a class="back-link" href={href('/blog')}>← All writing</a>

    <header class="post-header">
      <p class="post-meta">
        <FormattedDate date={data.pubDate} />
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </p>
      <h1 class="post-title">{data.title}</h1>
      <p class="post-lead">{data.description}</p>
      {
        data.tags.length > 0 && (
          <ul class="post-tags">
            {data.tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      data.heroImage && (
        <figure class="post-hero">
          <Image
            src={data.heroImage}
            alt={data.heroImageAlt ?? ''}
            widths={[480, 800, 1280]}
            sizes="(max-width: 44rem) 100vw, 44rem"
          />
        </figure>
      )
    }

    <div class="prose">
      <slot />
    </div>

    <footer class="post-footer">
      {
        data.updatedDate && (
          <p class="post-updated">
            Last updated <FormattedDate date={data.updatedDate} />
          </p>
        )
      }
      <a class="back-link" href={href('/blog')}>← All writing</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: var(--space-8) var(--space-10);
  }

  .back-link {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .post-header {
    margin-top: var(--space-6);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--text-faint);
  }

  .post-title {
    margin-top: var(--space-3);
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.022em;
  }

  .post-lead {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: 1.5;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin-top: var(--space-5);
  }

  .post-hero {
    margin-top: var(--space-6);
  }

  .post-hero :global(img) {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .prose {
    margin-top: var(--space-8);
  }

  .post-footer {
    margin-top: var(--space-10);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .post-updated {
    font-size: var(--text-sm);
    color: var(--text-faint);
  }
</style>
