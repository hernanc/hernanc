---
import { SITE, SOCIALS } from '../consts';
import { href } from '../lib/url';

const year = new Date().getFullYear();
const footerLinks = SOCIALS.filter(
  (link) => link.label !== 'X' && link.label !== 'Email',
);
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="footer-copy">
      © {year} {SITE.author}
    </p>

    <nav class="footer-links" aria-label="Social">
      {
        footerLinks.map((link) => (
          <a
            href={link.href}
            class="footer-link"
            rel="me noopener"
            target="_blank"
          >
            {link.label}
          </a>
        ))
      }
      <a class="footer-link" href={href('/rss.xml')}>RSS</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: var(--space-12);
    padding-block: var(--space-6);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .footer-copy {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-link {
    font-size: var(--text-sm);
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: var(--accent);
  }
</style>
